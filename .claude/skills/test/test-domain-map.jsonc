// Domain map for /test Smart Run mode.
//
// The skill applies these rules in this order on every run:
//   Layer 1 - tripwires           (full run if any match)
//   Layer 2 - vitest --related + playwright --only-changed
//   Layer 3 - backendOverrides + conventions + alwaysInclude
//   Layer 4 - mixedDomainThreshold (broaden to full tier)
//
// Maintenance contract:
//   - Add a tripwire when a new globally-imported infra file appears.
//   - Add a backendOverride when a new cross-cutting subsystem ships
//     where the test naming does NOT follow the source dirname (e.g. event-bridge
//     → *-activity-detection specs).
//   - Per-adapter, per-handler, per-component additions need NO map edit;
//     conventions auto-resolve via filesystem glob.
//   - When broadenOnUnmapped fires repeatedly for the same source path,
//     consider promoting it to a backendOverride entry.
//
// All globs use forward slashes. Claude reads this file and applies the rules
// in-prompt; comments are ignored at parse time.
{
  "tripwires": [
    "package.json",
    "package-lock.json",
    "tsconfig*.json",
    "vite.config.mts",
    "vite.*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "electron-builder.yml",
    "scripts/**",
    "src/shared/ipc-channels.ts",
    "src/shared/types.ts",
    "src/main/db/database.ts",
    "src/main/db/migrations.ts",
    "src/main/ipc/register-all.ts",
    "src/main/ipc/ipc-context.ts",
    "src/main/index.ts",
    "src/main/shutdown.ts",
    "src/preload/preload.ts",
    "src/renderer/App.tsx",
    "src/renderer/index.tsx"
  ],

  "alwaysInclude": {
    "src/renderer/App.tsx": {
      "unit": ["tests/unit/hmr-resync.test.ts"]
    },
    "src/main/ipc/handlers/**": {
      "unit": ["tests/unit/register-all-idempotency.test.ts", "tests/unit/bridge-utils.test.ts"]
    },
    "src/main/ipc/**": {
      "unit": ["tests/unit/register-all-idempotency.test.ts", "tests/unit/bridge-utils.test.ts"]
    }
  },

  "backendOverrides": [
    {
      "name": "agent:event-bridge",
      "match": [
        "src/main/agent/event-bridge.js",
        "src/main/agent/status-bridge.js"
      ],
      "specGlobs": ["tests/e2e/*-activity-detection.spec.ts"]
    },
    {
      "name": "agent:shared",
      "match": [
        "src/main/agent/agent-adapter.ts",
        "src/main/agent/agent-registry.ts",
        "src/main/agent/shared/**"
      ],
      "specGlobs": ["tests/e2e/*-activity-detection.spec.ts"]
    },
    {
      "name": "pty:activity",
      "match": ["src/main/pty/activity/**"],
      "specGlobs": [
        "tests/e2e/*-activity-detection.spec.ts",
        "tests/e2e/background-shell-idle.spec.ts",
        "tests/ui/task-activity-indicators.spec.ts"
      ]
    },
    {
      "name": "session-lifecycle",
      "match": [
        "src/main/pty/lifecycle/**",
        "src/main/pty/session-manager.ts",
        "src/main/pty/session-queue.ts",
        "src/main/pty/session-registry.ts",
        "src/main/engine/**"
      ],
      "specGlobs": [
        "tests/e2e/session-*.spec.ts",
        "tests/ui/session-*.spec.ts"
      ]
    },
    {
      "name": "git-worktree",
      "match": [
        "src/main/git/**",
        "src/main/ipc/handlers/git-*.ts"
      ],
      "specGlobs": [
        "tests/e2e/done-worktree-lifecycle.spec.ts",
        "tests/e2e/bulk-delete-worktrees.spec.ts",
        "tests/ui/task-changes-dialog.spec.ts",
        "tests/ui/task-detail-changes-panel.spec.ts"
      ]
    },
    {
      "name": "db:repositories",
      "match": ["src/main/db/repositories/**"],
      "specGlobs": ["tests/e2e/usage-history-survives-delete.spec.ts"]
    },
    {
      "name": "browser",
      "match": [
        "src/main/browser/**",
        "src/main/ipc/handlers/browser*.ts"
      ],
      "specGlobs": [
        "tests/e2e/browser-*.spec.ts",
        "tests/ui/browser-*.spec.ts"
      ]
    },
    {
      "name": "devtools",
      "match": [
        "src/devtools/**",
        "src/main/diagnostics/**"
      ],
      "specGlobs": ["tests/e2e/devtools-inspection.spec.ts"]
    }
  ],

  "conventions": {
    // For each rule, the skill extracts the <name> segment from a changed file's
    // path, then globs tests/{ui,e2e}/ for specs whose filename starts with
    // <name> (i.e. <name>*.spec.ts and <name>.spec.ts). Found specs are added
    // to the selection. No per-entry map edits when new adapters / handlers /
    // components ship -the filesystem glob picks them up automatically.
    "fromPathSegment": [
      { "match": "src/main/agent/adapters/<name>/**",  "segment": "name" },
      { "match": "tests/fixtures/mock-<name>*",        "segment": "name" },
      { "match": "src/renderer/components/<name>/**",  "segment": "name" },
      { "match": "src/main/ipc/handlers/<name>.ts",    "segment": "name" },
      { "match": "src/main/boards/adapters/<name>/**", "segment": "name" }
    ]
  },

  "broadenOnUnmapped": {
    "src/main/**": "e2e",
    "src/preload/**": "e2e",
    "src/renderer/**": "ui"
  },

  "mixedDomainThreshold": {
    "distinctOverrides": 3,
    "totalSourceFiles": 5
  }
}
